# =============================================================================
# AI Factory — Secrets reference
# =============================================================================
# These are NOT loaded from a .env file at runtime. They must be configured as
# GitHub Repository Secrets at:
#   https://github.com/<owner>/<repo>/settings/secrets/actions
#
# This file is documentation only — copy values into GitHub UI, not a local .env.
# =============================================================================

# Claude Code OAuth token (long-lived).
# Generate locally with:  claude setup-token
# Used by main.yml to authenticate Claude Code CLI in CI.
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub Personal Access Token (classic) with these scopes:
#   - repo         (read/write repos, issues, labels)
#   - workflow     (push workflow files — defensive)
#   - delete_repo  (cleanup-stale.sh deletes abandoned child repos)
# Generate at: https://github.com/settings/tokens
# Var name `GH_TOKEN` matches what `gh` CLI and our scripts expect.
# In GitHub Actions, this is stored as the `GH_TOKEN` secret and exposed as GH_TOKEN.
GH_TOKEN=
GH_ORG=

# Vercel deployment token.
# Used to deploy generated child sites to Vercel.
# Generate at: https://vercel.com/account/tokens
VERCEL_TOKEN=

# Vercel team ID — required when projects live under a team (not personal account).
# Find at: https://vercel.com/teams/<your-team>/settings (look for "Team ID")
# Or via API: curl -H "Authorization: Bearer $VERCEL_TOKEN" https://api.vercel.com/v2/teams
VERCEL_TEAM_ID=

# Custom-domain pattern for generated sites. Each new site gets:
#   ${DOMAIN_PREFIX}${REPO_NAME}.${BASE_DOMAIN}
# e.g. cafe-somjai -> demo-cafe-somjai.deelabs.co
# Requires a wildcard CNAME at Cloudflare: *.deelabs.co -> cname.vercel-dns.com (DNS-only).
# These are defaulted in the workflow (main.yml) — only set here for local script testing.
BASE_DOMAIN=deelabs.co
DOMAIN_PREFIX=demo-

# Neon Postgres connection string.
# Project: ai-web-builder  |  Postgres 17  |  AWS ap-southeast-1 (Singapore)
# Get from: Neon Console → your project → Connection Details → Copy
# Neon requires SSL — keep the `?sslmode=require` suffix.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/ai_web_builder?sslmode=require

# Note: `GITHUB_TOKEN` (different var) is auto-provided by GitHub Actions runtime
# for built-in repo access — never set it manually anywhere.
